modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "dbus", "expat", "libdrm", "mesa", "pango", "cairo", "alsa-lib", "libxkbcommon", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "libgbm"]

[userenv]

[userenv.production]
NEXT_PUBLIC_POSTROUND_API_BASE_URL = "https://postroundcoach-web.replit.app"
NEXT_PUBLIC_SITE_URL = "https://postroundcoach-web.replit.app"
NEXT_PUBLIC_SUPABASE_URL = "https://pcyhnijyfzmgyghrzlyp.supabase.co"

[userenv.development]
NEXT_PUBLIC_SUPABASE_URL = "https://pcyhnijyfzmgyghrzlyp.supabase.co"
