# Copy this file to .env.local and fill in your Supabase project values.
# These must also be added to Vercel Environment Variables for production.
#
# Both the website and the mobile app point to the SAME Supabase project.
# Find these values in your Supabase project: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public base URL for the separate Post Round app API. Do not include /api.
# The creator dashboard calls <base>/api/content/generate with the user's
# Supabase access token.
NEXT_PUBLIC_POSTROUND_API_BASE_URL=https://your-app-api.example.com

# Server-only. Required by protected admin telemetry/user-management routes.
# Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
