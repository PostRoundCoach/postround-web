# Copy this file to .env.local and fill in your Supabase project values.
# These must also be added to Vercel Environment Variables for production.
#
# Both the website and the mobile app point to the SAME Supabase project.
# Find these values in your Supabase project: Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
